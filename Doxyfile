# Doxyfile for Zappy GUI
PROJECT_NAME           = "Zappy GUI"
OUTPUT_DIRECTORY       = .
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
CASE_SENSE_NAMES       = YES
RECURSIVE              = YES
INPUT                  = src include
FILE_PATTERNS          = *.cpp *.hpp *.h
HTML_OUTPUT            = ../website/static/api/gui

# Doxygen Awesome CSS configuration
HTML_EXTRA_STYLESHEET  = ../docs/doxygen-awesome/doxygen-awesome.css \
                         ../docs/doxygen-awesome/doxygen-awesome-sidebar-only.css

HTML_EXTRA_FILES       = ../docs/doxygen-awesome/doxygen-awesome-darkmode-toggle.js \
                         ../docs/doxygen-awesome/doxygen-awesome-fragment-copy-button.js \
                         ../docs/doxygen-awesome/doxygen-awesome-interactive-toc.js \
                         ../docs/doxygen-awesome/doxygen-awesome-tabs.js

HTML_COLORSTYLE        = LIGHT # Required for Doxygen Awesome
GENERATE_TREEVIEW      = YES   # Recommended for Doxygen Awesome
